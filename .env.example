# Copy to .env.local and fill in only what you need. Never commit .env files.
# With NOTHING set, the app runs fully offline: local encrypted data store,
# local demo extractor (no AI), local text extraction (no OCR), payment stub.
# Every external service is opt-in. Do not put real keys in this file.

# --- Product ---------------------------------------------------------------
# Working name (not trademark-checked).
NEXT_PUBLIC_PRODUCT_NAME=ReadyFile
# Base URL used for payment redirects.
APP_BASE_URL=http://localhost:3000

# --- Feature flags -----------------------------------------------------------
# Criminal cases stay gated until an Ontario lawyer's written opinion on Crown
# disclosure handling arrives (decision 0001). Leave false.
FEATURE_CRIMINAL_CASES=false
# "Explore the sample case" demo accounts. Defaults to true for the local
# backend and false for Supabase.
# DEMO_MODE=true

# --- Data and auth -----------------------------------------------------------
# local (default) | supabase
DATA_BACKEND=local
# Local backend: where the encrypted store and files live (git-ignored).
LOCAL_DATA_DIR=.data
# Optional 64-hex-character AES-256 key. If unset, one is generated into
# LOCAL_DATA_DIR/.key on first run.
# LOCAL_DATA_KEY=
# Supabase backend (UNTESTED). Use a project in Canada (Central). The anon key
# is safe for the browser; no service-role key is used by the app.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_STORAGE_BUCKET=case-files
# Session length in days (local auth).
SESSION_TTL_DAYS=14
# Force secure cookies on or off (defaults to on in production over https).
# COOKIE_SECURE=true

# --- AI (summaries, timeline, discrepancy suggestions) ------------------------
# mock (default, local rule-based extractor) | anthropic
AI_PROVIDER=mock
# Only read when AI_PROVIDER=anthropic. Before using real case documents:
# request zero data retention from Anthropic and confirm the model is eligible.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- OCR (scans and photos) --------------------------------------------------
# local (default, no OCR) | textract
OCR_PROVIDER=local
# AWS credentials come from the standard AWS chain (env vars or a role).
# AWS_REGION=ca-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Payments ----------------------------------------------------------------
# mock (default, no charges) | stripe
PAYMENTS_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_CASE_PASS=
# STRIPE_PRICE_CASE_PASS_PLUS=

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=20
